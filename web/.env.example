# Публичные настройки сайта. Скопируйте в web/.env.local для локального запуска.
# Если VITE_SUPABASE_URL или VITE_SUPABASE_ANON_KEY не заданы, сайт работает в демо-режиме.

# Project URL из Supabase: Project Settings → API (или Data API).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Публичный anon-ключ или publishable-ключ (sb_publishable_...). Это НЕ секрет:
# доступ к данным ограничен Row Level Security. Никогда не указывайте здесь
# service_role / secret-ключ.
VITE_SUPABASE_ANON_KEY=

# Базовый путь сайта. Для https://USERNAME.github.io/REPOSITORY/ это /REPOSITORY/.
# Локально оставьте /.
VITE_BASE_PATH=/

# Необязательно: ссылка на репозиторий (кнопка «Скачать для Windows»).
VITE_REPOSITORY_URL=https://github.com/BlindSquidHeh/Squidify

# Необязательно: контакт оператора в политике конфиденциальности.
VITE_CONTACT_EMAIL=

# true — принудительно включить демо-режим.
VITE_DEMO_MODE=false
