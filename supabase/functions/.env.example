# Секреты Edge Functions. Для локального запуска скопируйте в
# supabase/functions/.env, для продакшена задайте командой:
#   supabase secrets set --env-file supabase/functions/.env
# Файл .env в репозиторий не коммитится.

# 32 случайных байта в base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Точные Redirect URI через запятую. Те же адреса добавьте в Spotify Dashboard.
ALLOWED_REDIRECT_URIS=https://USERNAME.github.io/REPOSITORY/callback/spotify/,http://127.0.0.1:5173/callback/spotify/

# Необязательно: Origin сайта для CORS у функций с авторизацией.
ALLOWED_ORIGINS=https://USERNAME.github.io,http://127.0.0.1:5173

# Необязательно: общий Client ID для режима «общее приложение».
# Оставьте пустым, пока приложение Spotify в Development Mode
# (там доступно максимум 5 пользователей, добавленных вручную).
SPOTIFY_SHARED_CLIENT_ID=
